# NEXTOS_CONTROLLERS — controles do NextOS / NextOS controls
# Riptide GP2: gamepad nativo, sem cursor na tela.
# O stick direito fica 100% nativo e livre para manobras.
# Formato próprio do NextOS. NÃO é gptokeyb: nunca vira teclado.
#
# IMPORTANTE: o loader só aceita as actions nativas abaixo (allowlist
# interna: A = south/nitro/confirma, B = east/volta). Edite apenas trocando
# A<->B entre si; qualquer outro valor é rejeitado (NXI1001) e o jogo aborta.
# Sticks, D-pad, gatilhos, R3 e START são sempre nativos (fora deste arquivo).
# Este arquivo é SEU: atualizações do port nunca sobrescrevem a sua cópia.
#
# IMPORTANT: the loader only accepts the native actions below (internal
# allowlist: A = south/nitro/confirm, B = east/back). Edit by swapping
# A<->B only; anything else is rejected (NXI1001) and the game aborts.
# Sticks, D-pad, triggers, R3 and START are always native (not in this file).
# This file is YOURS: port updates never overwrite your copy.

format = NEXTOS_CONTROLLERS/1
port = riptidegp1

[menu]
A = bb.confirm_powerup
B = bb.back

[gameplay]
A = bb.confirm_powerup
B = bb.back
